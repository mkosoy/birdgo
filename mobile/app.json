{
  "expo": {
    "name": "BirdGo",
    "slug": "birdgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b2b1c"
    },
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BirdGo uses your location to find nearby birds."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BirdGo uses your camera to identify birds."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "Com.mkosoy.birdgo",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BirdGo uses your location to find nearby birds.",
        "NSCameraUsageDescription": "BirdGo uses your camera to identify birds.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "package": "com.mkosoy.birdgo",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "extra": {
      "apiBaseUrl": "https://birdgo.vercel.app",
      "googleMapsApiKey": ""
    }
  }
}
